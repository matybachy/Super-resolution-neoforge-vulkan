#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D depthTexture;
layout(set = 0, binding = 1, rg16f) uniform image2D motionVectors;

layout(push_constant) uniform MotionMatrices {
    mat4 inverseCurrentViewProjection;
    mat4 previousViewProjection;
    mat4 currentViewProjection;
} matrices;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(motionVectors);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    float depth = texelFetch(depthTexture, pixel, 0).r;
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 world = matrices.inverseCurrentViewProjection * clip;
    world /= max(abs(world.w), 1e-6);

    vec4 current = matrices.currentViewProjection * world;
    vec4 previous = matrices.previousViewProjection * world;
    current /= max(abs(current.w), 1e-6);
    previous /= max(abs(previous.w), 1e-6);

    imageStore(motionVectors, pixel, vec4(previous.xy - current.xy, 0.0, 0.0));
}
